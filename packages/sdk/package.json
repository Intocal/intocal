{
  "name": "@intocal/sdk",
  "version": "0.3.1",
  "description": "Official TypeScript SDK for IntoCal — booking, scheduling, and calendar API for humans, developers, and AI agents.",
  "license": "MIT",
  "homepage": "https://intocal.com",
  "repository": { "type": "git", "url": "https://github.com/intocal/intocal" },
  "keywords": [
    "intocal", "scheduling", "booking", "calendar", "appointments",
    "calendly-alternative", "cal.com-alternative", "meetings", "availability",
    "google-calendar", "outlook", "zoom", "embed", "widget", "sdk", "ai-agent"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "echo \"no tests yet\""
  },
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "devDependencies": { "tsup": "^8.0.0", "typescript": "^5.4.0" }
}
